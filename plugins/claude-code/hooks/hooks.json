{
  "description": "Lossless capture of the session into the project's memory, and memory context at session start, per prompt and after compaction. Every hook exits 0: memory never blocks Claude Code.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "SessionStart"], "timeout": 120 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "UserPromptSubmit"], "timeout": 30 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "PreToolUse"], "timeout": 30 } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "PostToolUse"], "timeout": 60 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "PostToolUseFailure"], "timeout": 60 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "Stop"], "timeout": 60 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "SubagentStart"], "timeout": 30 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "SubagentStop"], "timeout": 30 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "PreCompact"], "timeout": 30 } ] }
    ],
    "PostCompact": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "PostCompact"], "timeout": 30 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/amem-run", "hook", "SessionEnd"] } ] }
    ]
  }
}
